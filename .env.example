# AeroNexusAdvanced - copy to .env (gitignored) and fill in; chmod 600 .env
# Service: deploy/pi/run-server.sh via systemd (docs/deploy-pi.md)
# Manual: python -m uvicorn aeronexus.app:app --host 127.0.0.1 --port 8000 --env-file .env

# Server (deploy/pi/run-server.sh). A non-loopback bind requires TLS
# (deploy/pi/tls-create-cert.sh) or AERONEXUS_ALLOW_PLAIN_HTTP_LAN=1.
AERONEXUS_BIND=127.0.0.1
AERONEXUS_PORT=8000
# AERONEXUS_TLS_CERT=/home/<user>/Projekte/AeroNexusAdvanced/config/pki/server.crt
# AERONEXUS_TLS_KEY=/home/<user>/Projekte/AeroNexusAdvanced/config/pki/server.key

# OPTIONAL token-free direct HTTPS access for /status and /studio in home LAN.
# Turning this on lets ALL hosts in 192.168.178.0/24 read telemetry,
# catalog and local studio media and create/edit/delete local missions/media.
# Only the actual Pi IP is accepted as URL host; do not port-forward/reverse-proxy.
# AERONEXUS_LAN_NO_TOKEN=1
# AERONEXUS_LAN_HOST=192.168.178.63
#
# Legacy bearer token used when LAN mode is not explicitly enabled.
# No token input is exposed in the new browser UIs.
# Dashboard bearer token, at least 32 characters. NOT a DJI credential.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(36))'
AERONEXUS_STATUS_TOKEN=
AERONEXUS_STATUS_STALE_AFTER_SECONDS=15
AERONEXUS_STATUS_REFRESH_SECONDS=5

# Optional local Mission Studio WebSocket change hints (default off).
# Only when the existing tokenless direct HTTPS LAN policy is enabled.
# Read-only cached fleet invalidations; 4 concurrent browser connections max.
# No DJI WebSocket, no direct flight commands, no tokens in URLs.
AERONEXUS_STUDIO_EVENTS=0

# P1/P2/P4 local GeoObject, GeoPhoto and survey preview APIs are available
# behind normal dashboard/LAN access; they do not create DJI commands.
# Optional P4 GeoTIFF import requires a matching Python osgeo/GDAL binding.
# Without GDAL, STL export from validated numeric grids still works.

# Read-only DJI Cloud API live feed (Pilot 2 -> AeroNexus EMQX), phase 9.
# Use the dedicated OSD-only broker account of AeroNexus (edge/.env AERONEXUS_OSD_*):
# EMQX ACL lets it subscribe thing/product/+/osd and nothing else.
AERONEXUS_CLOUD_MQTT_ENABLED=0
AERONEXUS_OSD_HOST=127.0.0.1
AERONEXUS_OSD_PORT=1884
AERONEXUS_OSD_USERNAME=aeronexus_osd
AERONEXUS_OSD_PASSWORD=
# AERONEXUS_OSD_TLS=1                  # verify the broker certificate (system CAs)
# AERONEXUS_OSD_ALLOW_PLAINTEXT_LAN=1  # required for a non-loopback broker without TLS
# AERONEXUS_OSD_STATE_ENABLED=1         # optional DJI /state events; OFF by default
#   Only enable when EMQX grants this dedicated reader SUBSCRIBE to
#   thing/product/+/state in addition to thing/product/+/osd, NEVER publish.
#   Requires real Pilot 2 -> own MQTT broker connection; does NOT set up
#   a DJI Pilot 2 Cloud API login/workspace, credentials or broker.
# AERONEXUS_CLOUD_PROJECT_ID=aeronexus # local inventory project for Cloud API devices

# Optional Cloud API 2 official SDK BFF bridge (not the DJI developer license).
# ONLY if a separate authenticated Cloud-API-2 SDK skeleton BFF already runs on
# a private HTTPS server. DJI native SDK needs x86_64; not the Pi ARM64.
# Never paste keys in chat, expose them in Chrome or commit your .env.
# AERONEXUS_CLOUDAPI2_ENABLED=1
# AERONEXUS_CLOUDAPI2_BFF_URL=https://192.168.178.90:8443
# AERONEXUS_CLOUDAPI2_BFF_TOKEN=     # backend JWT only; never a DJI org token
# AERONEXUS_CLOUDAPI2_STALE_SECONDS=45
# Feature remains disabled by default; TLS certificate MUST validate.
#
# FlightHub 2 OpenAPI V2 (phase 10, docs/phase-10-flighthub-fleet.md)
# Organization key: FlightHub 2 -> My Organization -> Organization Settings -> Cloud Interconnect / OpenAPI
AERONEXUS_FH_POLL_ENABLED=0
AERONEXUS_DJI_PROVIDER=public
AERONEXUS_DJI_REGION=eu               # eu | us | cn (key only valid in its region)
# AERONEXUS_DJI_BASE_URL=             # overrides region; required for onprem
# AERONEXUS_DJI_API_VERSION=v2.0      # public: v2.0 | v0.1
AERONEXUS_DJI_TOKEN=
# AERONEXUS_DJI_ORGANIZATION_ID=       # public: organization short code, verifies the key
# AERONEXUS_DJI_ORGANIZATION_UUID=     # required for onprem
# AERONEXUS_DJI_PROJECT_UUIDS=         # comma list; default: all projects (max 10)
# AERONEXUS_FH_POLL_SECONDS=30
# AERONEXUS_FH_CATALOG_SECONDS=600    # waylines/models/tasks; 0 = off
# Single-device diagnostics (probe_state, phase 8.6)
# AERONEXUS_DJI_PROJECT_UUID=
# AERONEXUS_DJI_DEVICE_SN=

# Optional read-only DJI MinIO catalogue (Phase 21)
# Use an S3 account scoped to dji-cloud: s3:ListBucket, s3:GetObject.
# Never reuse MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# AERONEXUS_MINIO_ENDPOINT=http://127.0.0.1:9000
# AERONEXUS_MINIO_BUCKET=dji-cloud
# AERONEXUS_MINIO_ACCESS_KEY=
# AERONEXUS_MINIO_SECRET_KEY=

# Optional thermography (/thermal): DJI Thermal SDK, installed by
# deploy/pi/install-thermal-sdk.sh (SDK is DJI-licensed, never committed).
# AERONEXUS_DJI_TSDK_DIR=/home/<user>/.local/opt/dji-tsdk
# AERONEXUS_DJI_TSDK_RUNNER=auto      # native on x86_64, box64 on ARM64
# AERONEXUS_BOX64=/home/<user>/.local/opt/aeronexus-box64/usr/bin/box64
# AERONEXUS_BOX64_X86_LIBS=/home/<user>/.local/opt/aeronexus-box64/x86libs
